{
  "projectName": "Ollamac",
  "projectType": "existing",
  "workflow": "gsd",
  "modelProfile": "balanced",
  "qualityGates": {
    "requireExplicitApprovalForProductionChanges": false,
    "requireExplicitApprovalForSchemaChanges": false,
    "autoCommit": true,
    "autoPush": false
  },
  "planning": {
    "createPlanPr": false,
    "createRoadmapPr": false,
