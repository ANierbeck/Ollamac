    "autoCreatePhaseDirectory": true,
    "autoCreateWaves": true,
    "parallelizeIndependentTasks": true,
    "waveSize": 4
  },
  "codebase": {
    "path": ".",
    "language": "swift",
    "framework": "swiftui",
    "hasTests": false,
    "testPath": null,
    "buildCommand": "xcodebuild -project Ollamac.xcodeproj -scheme Ollamac -destination 'platform=macOS'",
